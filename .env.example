# Deploy stack environment — copy to .env and fill in. docker-compose.yaml reads
# these; the ones marked REQUIRED have no default and the stack refuses to start
# without them (that is deliberate — the old defaults were credentials published
# in a public repo). Keep the real .env off the repo and mode 600.

# --- Postgres (REQUIRED) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host the backend/db-setup use to reach postgres over the compose network.
# Defaults to the service name `postgres`; override only if you renamed it.
POSTGRES_HOST=postgres
# Host-side loopback port the postgres service publishes (for local psql only).
POSTGRES_PORT_HOST=5433

# --- Auth (REQUIRED) ---
# Signing key for session tokens. Generate with: openssl rand -base64 48
# Rotating it logs everyone out once; it does not affect stored passwords.
JWT_SECRET=

# --- Superuser, provisioned once by db-setup (REQUIRED) ---
# There is no default admin/admin fallback anymore. Password must be >= 16 chars.
SUPERUSER_USERNAME=
SUPERUSER_PASSWORD=
SUPERUSER_EMAIL=

# --- Title metadata provider ---
# hybrid | tmdb | omdb | imdbapi  (hybrid needs both keys)
TITLE_PROVIDER=hybrid
TMDB_API_KEY=
OMDB_API_KEY=

# --- Activity feed (group activity events + unread badge + live SSE stream) ---
ACTIVITY_FEED_ENABLED=true
