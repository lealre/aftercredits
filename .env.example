# Deploy stack environment — copy to .env and fill in. docker-compose.yaml reads
# these; the ones marked REQUIRED have no default and the stack refuses to start
# without them (that is deliberate — the old defaults were credentials published
# in a public repo). Keep the real .env off the repo and mode 600.

# --- Postgres (REQUIRED) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Host the backend/db-setup use to reach postgres over the compose network.
# Defaults to the service name `postgres`; override only if you renamed it.
POSTGRES_HOST=postgres
# Host-side loopback port the postgres service publishes (for local psql only).
POSTGRES_PORT_HOST=5433

# --- Auth (REQUIRED) ---
# Signing key for session tokens. Generate with: openssl rand -base64 48
# Rotating it logs everyone out once; it does not affect stored passwords.
JWT_SECRET=

# --- Superuser, provisioned once by db-setup (REQUIRED) ---
# There is no default admin/admin fallback anymore. Password must be >= 16 chars.
SUPERUSER_USERNAME=
SUPERUSER_PASSWORD=
SUPERUSER_EMAIL=

# --- Title metadata provider ---
# hybrid | tmdb | omdb | imdbapi  (hybrid needs both keys)
TITLE_PROVIDER=hybrid
TMDB_API_KEY=
OMDB_API_KEY=

# --- Activity feed (group activity events + unread badge + live SSE stream) ---
ACTIVITY_FEED_ENABLED=true

# Cloudflare Tunnel connector token. ONLY needed on the machine that actually
# serves the tunnel — the connector is behind the `tunnel` compose profile, so
# local development needs none of this and `docker compose up` ignores it.
#
#   local   docker compose up -d
#   tunnel  docker compose --profile tunnel up -d
#
# From the dashboard:
#   Zero Trust -> Networks -> Tunnels -> <tunnel> -> the connector command.
#
# Required: the stack will not start without it. It is a credential — anyone
# holding it can run a connector for your tunnel — so it belongs here and never
# in the repository. Refresh it from that same screen if it is ever exposed.
#
# The public hostname itself is configured in the dashboard, not here, and must
# point at http://frontend:80 — cloudflared resolves the frontend by service
# name on the `tunnel` network. localhost inside that container is the
# container itself and serves nothing.
TUNNEL_TOKEN=

# Names of the externally-created Docker networks this stack joins. They must
# match whatever created them; the defaults suit a single-host setup.
INFRA_NETWORK=infra
TUNNEL_NETWORK=tunnel
